---
import type { HTMLAttributes } from 'astro/types';
import ScrollToTop from '../components/ScrollToTop.astro';
import '../styles/global.css';

interface Props extends HTMLAttributes<'html'> {
  title: string;
  description: string;
  favicon?: string;
  ogImage?: string;
  canonicalUrl?: string;
  lang?: string;
  theme?: 'light' | 'dark' | 'system';
  googleAnalyticsId?: string;
  handTalkToken?: string;
  hasScrollToTop?: boolean;
}

const {
  title,
  description,
  favicon = '/favicon.svg',
  googleAnalyticsId,
  ogImage = '/og-default.jpg',
  canonicalUrl = Astro.url.href,
  lang = 'pt-BR',
  theme = 'light',
  handTalkToken,
  hasScrollToTop = true,
  ...rest
} = Astro.props;
---

<!doctype html>
<html lang={lang} {...rest}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="icon" type="image/svg+xml" href={favicon} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <script is:inline define:vars={{ defaultTheme: theme }}>
      const getThemePreference = () => {
        if (
          typeof localStorage !== 'undefined' &&
          localStorage.getItem('theme')
        ) {
          return localStorage.getItem('theme');
        }

        if (defaultTheme === 'light' || defaultTheme === 'dark') {
          return defaultTheme;
        }

        return window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light';
      };

      const activeTheme = getThemePreference();
      document.documentElement.setAttribute('data-theme', activeTheme);
    </script>

    {
      googleAnalyticsId && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`}
          />
          <script
            is:inline
            set:html={`
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', '${googleAnalyticsId}');
          `}
          />
        </>
      )
    }

    <slot name="head" />
  </head>
  <body>
    <a
      href="#main-content"
      class="sinc-main-content-link sinc-sr-only --focusable"
      >Pular para o conteúdo principal</a
    >

    <div id="app-root">
      <slot />
    </div>

    {hasScrollToTop && <ScrollToTop />}

    <div class="sinc-global-overlay" data-global-overlay aria-hidden="true">
    </div>

    {
      handTalkToken && (
        <>
          <script
            is:inline
            src="https://plugin.handtalk.me/web/latest/handtalk.min.js"
          />
          <script
            is:inline
            set:html={`
          var ht = new HT({
            token: ${handTalkToken},
            avatar: "MAYA",
            pageSpeech: true
          });
        `}
          />
        </>
      )
    }
  </body>
</html>

<script>
  import { closeOpenElements, setAriaState, toggleTheme } from '../utils/dom';

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (target.matches('[data-global-overlay]')) {
      closeOpenElements();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      closeOpenElements();
    }
  });

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const themeBtn = target.closest('[data-theme-toggle]') as HTMLElement;

    if (themeBtn) {
      const newTheme = toggleTheme();
      const isDark = newTheme === 'dark';

      setAriaState(themeBtn, 'aria-pressed', isDark, 'data-active');
    }
  });
</script>
