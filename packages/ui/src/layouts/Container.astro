---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'div'> {
  as?: 'div' | 'section';
  size?: 'sm' | 'md' | 'lg' | 'xl' | 'xxl' | 'full';
  padding?: 'none' | 'sm' | 'md' | 'lg';
  positionX?: 'left' | 'center' | 'right';
  positionY?: 'top' | 'center' | 'bottom';
  isContainerQuery?: boolean;
}

const {
  as: Tag = 'div',
  size = 'xl',
  padding = 'md',
  positionX = 'center',
  positionY = 'top',
  isContainerQuery = false,
  class: className,
  style,
  ...rest
} = Astro.props;

const sizeMap = {
  sm: '64rem',
  md: '76.8rem',
  lg: '102.4rem',
  xl: '128rem',
  xxl: '153.6rem',
  full: '100%',
};

const maxWidth = sizeMap[size] || sizeMap.xl;
---

<Tag
  class:list={[
    'sinc-container',
    `sinc-container--padding-${padding}`,
    `sinc-container--pos-x-${positionX}`,
    `sinc-container--pos-y-${positionY}`,
    { 'is-container-query': isContainerQuery },
    className,
  ]}
  style={[{ '--sinc-container-max-width': maxWidth }, style]}
  {...rest}
>
  <slot />
</Tag>

<style>
  .sinc-container {
    position: relative;
    width: 100%;
    max-width: var(--sinc-container-max-width);

    &.sinc-container--pos-x-center {
      margin-inline: auto;
    }

    &.sinc-container--pos-x-left {
      margin-inline-start: 0;
      margin-inline-end: auto;
    }

    &.sinc-container--pos-x-right {
      margin-inline-start: auto;
      margin-inline-end: 0;
    }

    &.sinc-container--pos-y-top {
      display: block;
    }

    &.sinc-container--pos-y-center,
    &.sinc-container--pos-y-bottom {
      display: flex;
      flex-direction: column;
      min-height: var(--sinc-container-min-height, 100dvh);
    }

    &.sinc-container--pos-y-center {
      justify-content: center;
    }

    &.sinc-container--pos-y-bottom {
      justify-content: flex-end;
    }

    &.sinc-container--padding-none {
      padding-inline: 0;
    }
    &.sinc-container--padding-sm {
      padding-inline: var(--spacing-3);
    }
    &.sinc-container--padding-md {
      padding-inline: var(--spacing-4);
    }
    &.sinc-container--padding-lg {
      padding-inline: var(--spacing-6);
    }

    &.is-container-query {
      container-type: inline-size;
      container-name: main-container;
    }
  }
</style>
