---
import Page from './Page.astro';

interface Props {
  title: string;
  description: string;
  ogImage: string;
  favicon?: string;
  canonicalUrl?: string;
  lang?: string;
  theme?: 'light' | 'dark' | 'system';
  googleAnalyticsId?: string;
  handTalkToken?: string;
}
---

<Page {...Astro.props}>
  <header>
    <slot name="header" />
  </header>

  <main id="main-content">
    <slot />
  </main>

  <footer>
    <slot name="footer" />
  </footer>
</Page>

<style>
  :global(#app-root) {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1 0 auto;
  }

  header,
  footer {
    flex-shrink: 0;
  }
</style>
