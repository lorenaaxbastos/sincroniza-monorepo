---
import Page from './Page.astro';

interface Props {
  title: string;
  description: string;
  ogImage: string;
  favicon?: string;
  canonicalUrl?: string;
  lang?: string;
  theme?: 'light' | 'dark' | 'system';
  googleAnalyticsId?: string;
  handTalkToken?: string;
}
---

<Page {...Astro.props}>
  <div class="sinc-app-shell">
    {
      Astro.slots.has('sidebar') && (
        <aside class="sinc-app-sidebar" aria-label="Navegação Principal">
          <slot name="sidebar" />
        </aside>
      )
    }

    <div class="sinc-app-view">
      {
        Astro.slots.has('topbar') && (
          <header class="sinc-app-topbar">
            <slot name="topbar" />
          </header>
        )
      }

      <main id="main-content" class="sinc-app-main">
        <slot />
      </main>

      {
        Astro.slots.has('footer') && (
          <footer class="sinc-app-footer">
            <slot name="footer" />
          </footer>
        )
      }
    </div>
  </div>
</Page>

<style>
  :global(#app-root) {
    height: 100vh;
    overflow: hidden;
  }

  .sinc-app-shell {
    display: flex;
    width: 100vw;
    height: 100vh;
  }

  .sinc-app-sidebar {
    flex-shrink: 0;
    height: 100%;
  }

  .sinc-app-view {
    display: flex;
    flex-direction: column;
    flex: 1;
    height: 100%;
    overflow: hidden;
  }

  .sinc-app-topbar,
  .sinc-app-footer {
    flex-shrink: 0;
  }

  .sinc-app-main {
    flex: 1;
    overflow-y: auto;
    padding: var(--spacing-6, 2rem);
  }
</style>
