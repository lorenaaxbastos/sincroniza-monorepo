---
import type { HTMLAttributes } from 'astro/types';
import Tooltip from './Tooltip.astro';

type NavColor =
  | 'primary'
  | 'secondary'
  | 'tertiary'
  | 'quaternary'
  | 'body'
  | 'inverse'
  | 'light'
  | 'dark'
  | 'white'
  | 'black';

export interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: 'sidebar' | 'header';
  label?: string;
  baseColor?: NavColor;
  activeColor?: NavColor;
  activeTextColor?: NavColor;
}

const {
  href,
  variant = 'sidebar',
  label,
  baseColor,
  activeColor,
  activeTextColor = 'white',
  class: className,
  style,
  ...rest
} = Astro.props;

const { pathname } = Astro.url;
const cleanPathname = pathname.replace(/\/$/, '');
const cleanHref = href.replace(/\/$/, '');
const isActive = cleanPathname === cleanHref;
const isSidebar = variant === 'sidebar';
const tooltipContent = label || (rest['aria-label'] as string);

const colorMap: Record<NavColor, string> = {
  primary: 'var(--color-primary)',
  secondary: 'var(--color-secondary)',
  tertiary: 'var(--color-tertiary)',
  quaternary: 'var(--color-quaternary)',
  body: 'var(--color-text-body)',
  inverse: 'var(--color-text-inverse)',
  light: 'var(--color-gray-100)',
  dark: 'var(--color-gray-900)',
  white: 'var(--color-white)',
  black: 'var(--color-black)',
};

const resolvedBaseColor = baseColor
  ? colorMap[baseColor]
  : isSidebar
    ? colorMap.white
    : colorMap.secondary;

const resolvedActiveColor = activeColor
  ? colorMap[activeColor]
  : colorMap.primary;

const resolvedActiveTextColor = colorMap[activeTextColor];
---

<li class="sinc-nav-item">
  <Tooltip
    content={tooltipContent}
    position="right"
    class:list={['sinc-nav-link-tooltip', { 'is-sidebar-link': isSidebar }]}
  >
    <a
      href={href}
      class:list={[
        'sinc-nav-link',
        `sinc-nav-link--${variant}`,
        { 'is-active': isActive },
        className,
      ]}
      aria-current={isActive ? 'page' : undefined}
      style={[
        {
          '--nav-base-color': resolvedBaseColor,
          '--nav-active-color': resolvedActiveColor,
          '--nav-active-text-color': resolvedActiveTextColor,
        },
        style,
      ]}
      {...rest}
    >
      {
        Astro.slots.has('icon') && (
          <span class="sinc-nav-link-icon">
            <slot name="icon" />
          </span>
        )
      }
      <span class="sinc-nav-link-label">
        <slot />
      </span>
    </a>
  </Tooltip>
</li>

<style>
  .sinc-nav-item {
    list-style: none;
  }

  .sinc-nav-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    width: fit-content;
    text-decoration: none;
    transition:
      background-color var(--transition-smooth),
      color var(--transition-smooth);

    &.sinc-nav-link--sidebar {
      width: 100%;
      padding: var(--spacing-2) var(--spacing-4);
      border-radius: var(--radii-sm);
      color: var(--nav-base-color);

      &:hover {
        background-color: color-mix(
          in srgb,
          var(--nav-base-color),
          transparent 88%
        );
      }

      &.is-active,
      &.is-active:hover {
        background-color: var(--nav-active-color);
        color: var(--nav-active-text-color);
        font-weight: var(--font-weight-bold);
      }

      @container sidebar (max-width: 6rem) {
        justify-content: center;
        padding: var(--spacing-3);

        .sinc-nav-link-label {
          display: none;
        }
      }
    }

    &.sinc-nav-link--header {
      padding: var(--spacing-1);
      color: var(--nav-base-color);
      position: relative;

      &::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background-color: var(--nav-active-color);
        transform: scaleX(0);
        transform-origin: center;
        transition: var(--transition-smooth);
      }

      &:hover,
      &.is-active {
        color: var(--nav-active-color);

        &::after {
          transform: scaleX(1);
        }
      }

      &.is-active {
        font-weight: var(--font-weight-bold);
      }
    }
  }

  .sinc-nav-link-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .sinc-nav-link-label {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sinc-nav-link-tooltip {
    width: 100%;

    &.is-sidebar-link {
      --sinc-tooltip-display: none;

      @container sidebar (max-width: 5rem) {
        --sinc-tooltip-display: block;
      }
    }

    &:not(.is-sidebar-link) {
      --sinc-tooltip-display: none;
    }
  }
</style>
