---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'span'> {
  variant?: 'solid' | 'subtle' | 'outline';
  color?:
    | 'primary'
    | 'secondary'
    | 'tertiary'
    | 'quaternary'
    | 'success'
    | 'warning'
    | 'error'
    | 'info'
    | 'light'
    | 'dark'
    | 'white'
    | 'black'
    | 'surface';
  size?: 'sm' | 'md' | 'lg';
  isPill?: boolean;
  isUppercase?: boolean;
  hasDot?: boolean;
}

const {
  variant = 'subtle',
  color = 'primary',
  size = 'md',
  isPill = false,
  isUppercase = false,
  hasDot = false,
  class: className,
  ...rest
} = Astro.props;
---

<span
  class:list={[
    'sinc-badge',
    `sinc-badge--${variant}`,
    `sinc-badge--${color}`,
    `sinc-badge--${size}`,
    { 'sinc-badge--pill': isPill },
    { 'sinc-badge--uppercase': isUppercase },
    className,
  ]}
  {...rest}
>
  {hasDot && <span class="sinc-badge__dot" aria-hidden="true" />}
  <slot />
</span>

<style>
  .sinc-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-1);
    width: fit-content;
    white-space: nowrap;
    border: 1px solid transparent;
    border-radius: var(--radii-sm);
    font-family: inherit;
    font-weight: var(--font-weight-semibold);
    line-height: 1;
    user-select: none;

    &.sinc-badge--primary {
      --badge-color: var(--color-primary);
    }

    &.sinc-badge--secondary {
      --badge-color: var(--color-secondary);
    }

    &.sinc-badge--tertiary {
      --badge-color: var(--color-tertiary);
    }

    &.sinc-badge--quaternary {
      --badge-color: var(--color-quaternary);
    }

    &.sinc-badge--success {
      --badge-color: var(--color-feedback-success);
    }

    &.sinc-badge--warning {
      --badge-color: var(--color-feedback-warning);
    }

    &.sinc-badge--error {
      --badge-color: var(--color-feedback-error);
    }

    &.sinc-badge--info {
      --badge-color: var(--color-feedback-info);
    }

    &.sinc-badge--light {
      --badge-color: var(--color-gray-200);
      --badge-text-color: var(--color-gray-900);
    }

    &.sinc-badge--dark {
      --badge-color: var(--color-gray-900);
      --badge-text-color: var(--color-gray-100);
    }

    &.sinc-badge--white {
      --badge-color: var(--color-white);
      --badge-text-color: var(--color-black);
    }

    &.sinc-badge--black {
      --badge-color: var(--color-black);
      --badge-text-color: var(--color-white);
    }

    &.sinc-badge--surface {
      --badge-color: var(--color-gray-400);
      --badge-text-color: var(--color-gray-700);
    }

    &.sinc-badge--solid {
      background-color: var(--badge-color);
      color: var(--badge-text-color, var(--color-white, #ffffff));
    }

    &.sinc-badge--subtle {
      background-color: color-mix(in srgb, var(--badge-color), transparent 85%);
      color: var(--badge-text-color, var(--badge-color));
      border-color: color-mix(in srgb, var(--badge-color), transparent 75%);
    }

    &.sinc-badge--outline {
      background-color: transparent;
      border-color: var(--badge-color);
      color: var(--badge-text-color, var(--badge-color));
    }

    &.sinc-badge--sm {
      padding: var(--spacing-1) var(--spacing-2);
      font-size: var(--font-size-xs);
    }

    &.sinc-badge--md {
      padding: calc(var(--spacing-1) * 1.5) var(--spacing-3);
      font-size: var(--font-size-xs);
    }

    &.sinc-badge--lg {
      padding: var(--spacing-2) var(--spacing-4);
      font-size: var(--font-size-sm);
    }

    &.sinc-badge--pill {
      border-radius: var(--radii-pill);
    }

    &.sinc-badge--uppercase {
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .sinc-badge__dot {
      width: 0.5em;
      height: 0.5em;
      border-radius: var(--radii-round);
      background-color: currentColor;
      flex-shrink: 0;
    }
  }

  :global(svg) {
    flex-shrink: 0;
  }
</style>
