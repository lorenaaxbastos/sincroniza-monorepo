---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'div'> {
  content?: string;
  position?: 'top' | 'bottom' | 'left' | 'right';
  align?: 'center' | 'start' | 'end';
  isDisabled?: boolean;
}

const {
  content,
  position = 'top',
  align = 'center',
  isDisabled = false,
  class: className,
  ...rest
} = Astro.props;
---

<div
  class:list={[
    'sinc-tooltip-wrapper',
    { 'is-disabled': isDisabled },
    className,
  ]}
  {...rest}
>
  <slot />

  {
    !isDisabled && (content || Astro.slots.has('content')) && (
      <span
        class:list={[
          'sinc-tooltip',
          `sinc-tooltip--${position}`,
          `sinc-tooltip--align-${align}`,
        ]}
        role="tooltip"
      >
        <slot name="content">{content}</slot>
      </span>
    )
  }
</div>

<style>
  .sinc-tooltip-wrapper {
    position: relative;
    display: inline-flex;

    &:is(:hover, :focus-within):not(.is-disabled) .sinc-tooltip {
      opacity: 1;
      visibility: visible;
    }
  }

  .sinc-tooltip {
    display: var(--sinc-tooltip-display, block);
    position: absolute;
    z-index: var(--z-index-tooltip);
    padding: var(--spacing-1) var(--spacing-3);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-shorter);
    color: var(--color-text-inverse);
    background-color: var(--color-gray-900);
    border-radius: var(--radii-sm);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--transition-fast),
      visibility var(--transition-fast);
    box-shadow: 0 0.4rem 1.2rem
      color-mix(in srgb, var(--color-black), transparent 75%);

    &.sinc-tooltip--top {
      bottom: calc(100% + var(--spacing-2));
      left: 50%;
      transform: translateX(-50%);

      &.sinc-tooltip--align-start {
        left: 0;
        transform: none;
      }

      &.sinc-tooltip--align-end {
        left: auto;
        right: 0;
        transform: none;
      }
    }

    &.sinc-tooltip--bottom {
      top: calc(100% + var(--spacing-2));
      left: 50%;
      transform: translateX(-50%);

      &.sinc-tooltip--align-start {
        left: 0;
        transform: none;
      }

      &.sinc-tooltip--align-end {
        left: auto;
        right: 0;
        transform: none;
      }
    }

    &.sinc-tooltip--left {
      right: calc(100% + var(--spacing-2));
      top: 50%;
      transform: translateY(-50%);

      &.sinc-tooltip--align-start {
        top: 0;
        transform: none;
      }

      &.sinc-tooltip--align-end {
        top: auto;
        bottom: 0;
        transform: none;
      }
    }

    &.sinc-tooltip--right {
      left: calc(100% + var(--spacing-2));
      top: 50%;
      transform: translateY(-50%);

      &.sinc-tooltip--align-start {
        top: 0;
        transform: none;
      }

      &.sinc-tooltip--align-end {
        top: auto;
        bottom: 0;
        transform: none;
      }
    }
  }
</style>
