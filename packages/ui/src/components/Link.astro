---
import type { HTMLAttributes } from 'astro/types';
import { ExternalLink } from 'lucide-react';

export interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: 'default' | 'muted';
  color?:
    | 'primary'
    | 'secondary'
    | 'tertiary'
    | 'quaternary'
    | 'light'
    | 'dark'
    | 'white'
    | 'black'
    | 'inherit';
  size?: 'sm' | 'md' | 'lg' | 'inherit';
  underline?: 'always' | 'hover' | 'none';
  isExternal?: boolean;
  showExternalIcon?: boolean;
}

const {
  href,
  variant = 'default',
  color = 'primary',
  size = 'inherit',
  underline = 'hover',
  isExternal,
  showExternalIcon = false,
  class: className,
  target,
  rel,
  ...rest
} = Astro.props;

const autoExternal =
  typeof href === 'string' &&
  (href.startsWith('http://') || href.startsWith('https://'));
const external = isExternal ?? autoExternal;

const linkTarget = external ? target || '_blank' : target;
const linkRel = external ? rel || 'noopener noreferrer' : rel;
---

<a
  href={href}
  target={linkTarget}
  rel={linkRel}
  class:list={[
    'sinc-link',
    `sinc-link--${variant}`,
    `sinc-link--${color}`,
    `sinc-link--size-${size}`,
    `sinc-link--underline-${underline}`,
    { 'sinc-link--external': external },
    className,
  ]}
  {...rest}
>
  <slot />
  {
    external && (
      <>
        <span class="sinc-sr-only">(abre em uma nova aba)</span>
        {showExternalIcon && (
          <ExternalLink
            className="sinc-link__external-icon"
            aria-hidden="true"
          />
        )}
      </>
    )
  }
</a>

<style>
  .sinc-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    font-weight: var(--font-weight-medium);
    text-decoration-line: none;
    transition:
      color var(--transition-smooth),
      text-decoration-color var(--transition-smooth);
    outline-offset: 2px;
    border-radius: var(--radii-xs);

    &.sinc-link--primary {
      color: var(--color-primary);

      &:hover {
        color: color-mix(in srgb, var(--color-primary), var(--color-black) 15%);
      }
    }

    &.sinc-link--secondary {
      color: var(--color-secondary);

      &:hover {
        color: color-mix(
          in srgb,
          var(--color-secondary),
          var(--color-black) 15%
        );
      }
    }

    &.sinc-link--tertiary {
      color: var(--color-tertiary);

      &:hover {
        color: color-mix(
          in srgb,
          var(--color-tertiary),
          var(--color-black) 15%
        );
      }
    }

    &.sinc-link--quaternary {
      color: var(--color-quaternary);

      &:hover {
        color: color-mix(
          in srgb,
          var(--color-quaternary),
          var(--color-black) 15%
        );
      }
    }

    &.sinc-link--light {
      color: var(--color-gray-100);

      &:hover {
        color: color-mix(
          in srgb,
          var(--color-gray-100),
          var(--color-black) 15%
        );
      }
    }

    &.sinc-link--dark {
      color: var(--color-gray-900);

      &:hover {
        color: color-mix(
          in srgb,
          var(--color-gray-900),
          var(--color-white) 15%
        );
      }
    }

    &.sinc-link--white {
      color: var(--color-white);

      &:hover {
        color: color-mix(in srgb, var(--color-white), var(--color-black) 15%);
      }
    }

    &.sinc-link--black {
      color: var(--color-black);

      &:hover {
        color: color-mix(in srgb, var(--color-black), var(--color-white) 15%);
      }
    }

    &.sinc-link--inherit {
      color: inherit;

      &:hover {
        color: color-mix(in srgb, currentColor, var(--color-white) 15%);
      }
    }

    &.sinc-link--muted {
      color: var(--color-gray-500);

      &:hover {
        color: inherit;
      }
    }

    &.sinc-link--underline-always {
      text-decoration-line: underline;
      text-underline-offset: 3px;
    }

    &.sinc-link--underline-hover {
      text-decoration-line: none;
      text-underline-offset: 3px;

      &:hover {
        text-decoration-line: underline;
      }
    }

    &.sinc-link--underline-none {
      text-decoration-line: none !important;
    }

    &.sinc-link--size-sm {
      font-size: var(--font-size-xs);
    }
    &.sinc-link--size-md {
      font-size: var(--font-size-sm);
    }
    &.sinc-link--size-lg {
      font-size: var(--font-size-md);
    }
    &.sinc-link--size-inherit {
      font-size: inherit;
    }

    .sinc-link__external-icon {
      width: 0.85em;
      height: 0.85em;
      display: inline-block;
      vertical-align: middle;
      opacity: 0.5;
      transition:
        transform var(--transition-smooth),
        opacity var(--transition-smooth);
    }

    &:hover .sinc-link__external-icon {
      transform: translate(2px, -2px);
      opacity: 1;
    }
  }
</style>
