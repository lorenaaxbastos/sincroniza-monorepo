{
  "name": "@sincroniza/ui",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./layouts/*": {
      "types": "./src/layouts/*",
      "default": "./src/layouts/*"
    },
    "./components/*": {
      "types": "./src/components/*",
      "default": "./src/components/*"
    }
  },
  "scripts": {
    "generate:tokens": "tsx scripts/generate-tokens.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "astro check"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@sincroniza/tokens": "workspace:*",
    "@sincroniza/tsconfig": "workspace:*",
    "@sincroniza/vitest-config": "workspace:*",
    "@types/node": "^25.9.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "astro": "^5.18.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  }
}
